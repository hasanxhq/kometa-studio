# Starr Studio environment configuration example.
# Copy to ~/.config/starr-studio/studio.env and adjust paths for your user.
# Note: systemd EnvironmentFile does not expand ~ or $HOME. Use absolute paths.

# Network binding
# Bind to 127.0.0.1 when running behind a local reverse proxy or on a shared host.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=8484

# Studio data storage (database, cached covers, full backups)
STUDIO_DATA_DIR=/home/username/.config/starr-studio/data

# Kometa installation paths
# Kometa must be installed in its own separate virtual environment.
STUDIO_KOMETA_PYTHON=/home/username/kometa/.venv/bin/python3
STUDIO_KOMETA_ENTRY=/home/username/kometa/kometa.py
STUDIO_KOMETA_CONFIG=/home/username/kometa/config/config.yml

# Kometa JSON schemas (optional; defaults to json-schema/ beside kometa.py if unset)
STUDIO_KOMETA_SCHEMAS=/home/username/kometa/json-schema

# Timezone for new schedules (e.g. Europe/Paris, America/New_York). Defaults to system TZ or UTC.
STUDIO_TIMEZONE=UTC

# Run execution limits (in seconds)
# Stop a run after this duration (default: 10800 = 3 hours)
STUDIO_RUN_TIMEOUT=10800
# Grace period before SIGKILL if Kometa does not exit after SIGTERM (default: 30)
STUDIO_KILL_AFTER=30

# Shared server security
# On a shared host or seedbox, other customers share loopback and the private network, so set this
# to false. Create the user first (starr-studio create-user): with it off and no user, Studio refuses everyone.
STUDIO_ALLOW_LOCAL=false
